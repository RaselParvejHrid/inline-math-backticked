{
    "name": "markdown-math-utilities",
    "displayName": "Markdown Math Utilities",
    "version": "2.0.0",
    "publisher": "raselparvej",
    "engines": {
        "vscode": "^1.70.0"
    },
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:markdown"
    ],
    "contributes": {
        "commands": [
            {
                "command": "MarkdownMath.backtickInlines",
                "title": "Markdown Math: Backtick Inlines"
            },
            {
                "command": "MarkdownMath.unbacktickInlines",
                "title": "Markdown Math: Unbacktick Inlines"
            },
            {
                "command": "MarkdownMath.doubleDollarToMathFence",
                "title": "Markdown Math:  $$ to ```math"
            },
            {
                "command": "MarkdownMath.MathFenceToDoubleDollar",
                "title": "Markdown Math: ```math to $$"
            },
            {
                "command": "MarkdownMath.addTheIgnoreComment",
                "title": "Markdown Math: Ignore"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "MarkdownMath.backtickInlines",
                    "when": "editorTextFocus && resourceLangId == markdown",
                    "group": "1_modification"
                },
                {
                    "command": "MarkdownMath.unbacktickInlines",
                    "when": "editorTextFocus && resourceLangId == markdown",
                    "group": "1_modification"
                },
                {
                    "command": "MarkdownMath.doubleDollarToMathFence",
                    "when": "editorTextFocus && resourceLangId == markdown",
                    "group": "1_modification"
                },
                {
                    "command": "MarkdownMath.MathFenceToDoubleDollar",
                    "when": "editorTextFocus && resourceLangId == markdown",
                    "group": "1_modification"
                },
                {
                    "command": "MarkdownMath.addTheIgnoreComment",
                    "when": "editorTextFocus && resourceLangId == markdown",
                    "group": "1_modification"
                }
            ]
        }
    }
}